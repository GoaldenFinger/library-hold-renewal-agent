# Server Port (default: 3000)
PORT=3000

# Koha Demo OPAC Base URL (read-only public catalogue search)
KOHA_CATALOGUE_URL=http://opacdemo.kohasupport.com

# Optional Browserbase Credentials (for Stagehand live browser automation smoke test: stagehand-smoke.mjs)
# NOTE: The entire test suite (171 tests), conversational assistant, simulation engine, and task
# orchestrator run 100% offline without these credentials.
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here
